{
  "name": "msikaai-backend",
  "version": "1.0.0",
  "description": "MsikaAI Backend API - AI-powered community commerce platform for Malawi",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "production": "pm2 start ecosystem.config.js --env production",
    "stop": "pm2 stop msikaai-backend",
    "restart": "pm2 restart msikaai-backend",
    "logs": "pm2 logs msikaai-backend",
    "build": "echo 'No build step required' && exit 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "worker:notifications": "node src/workers/notificationWorker.js",
    "worker:email": "node src/workers/emailWorker.js",
    "worker:analytics": "node src/workers/analyticsWorker.js",
    "worker:images": "node src/workers/imageWorker.js",
    "search:sync": "node src/scripts/syncSearch.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.112.3",
    "@xenova/transformers": "^2.17.2",
    "amqplib": "^0.10.9",
    "axios": "^1.19.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.31.2",
    "drizzle-zod": "^0.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "groq-sdk": "^1.5.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "meilisearch": "^0.39.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "openai": "^4.104.0",
    "openrouter-sdk": "^1.0.9",
    "postgres": "^3.4.3",
    "resend": "^4.8.0",
    "sharp": "^0.33.5",
    "stripe": "^22.5.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.11.0",
    "drizzle-kit": "^0.22.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
