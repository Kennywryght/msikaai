# In root directory, create/update .gitignore
cat > .gitignore << 'EOF'
# Environment files
.env
.env.local
.env.*.local

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Build files
dist/
build/
*.log
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Coverage files
coverage/
.nyc_output/

# Deployment
logs/
.terraform/
*.pem

# Misc
*.pem
*.p12
*.pfx
EOF